{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "OpenWeather": {
    "ApiKey": "",
    "BaseUrl": "https://api.openweathermap.org/data/2.5/"
  },
  "WeatherCollector": {
    "IntervalMinutes": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
