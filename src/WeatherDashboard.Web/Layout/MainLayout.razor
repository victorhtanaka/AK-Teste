@inherits LayoutComponentBase

<div class="app-layout">
    <!-- Header Principal Acessível e Semântico -->
    <header class="app-header" role="banner">
        <div class="header-container">
            <div class="brand-area">
                <div class="brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
                        <path d="M12 2v2M4.93 4.93l1.41 1.41M2 12h2M19.07 4.93l-1.41 1.41" />
                    </svg>
                </div>
                <div class="brand-info">
                    <h1 class="brand-title">Clima Brasil — Capitais</h1>
                    <span class="brand-subtitle">Monitoramento Meteorológico Contínuo</span>
                </div>
            </div>

            <nav class="header-actions" aria-label="Ações globais da aplicação">
                <div class="sync-status-badge" role="status" aria-label="Status do coletor: Ativo a cada 15 minutos">
                    <span class="pulse-dot" aria-hidden="true"></span>
                    <span>Worker Ativo (15m)</span>
                </div>
                <button type="button" 
                        class="btn-action-header" 
                        @onclick="ToggleInfoModal"
                        aria-haspopup="dialog"
                        aria-expanded="@(ShowInfoModal ? "true" : "false")">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="16" x2="12" y2="12" />
                        <line x1="12" y1="8" x2="12.01" y2="8" />
                    </svg>
                    <span>Sobre o Projeto</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- Conteúdo Principal -->
    <main id="main-content" class="main-content" role="main">
        @Body
    </main>

    <!-- Rodapé Semântico -->
    <footer class="app-footer" role="contentinfo">
        <div class="footer-container">
            <p>© @DateTime.UtcNow.Year Dashboard Climático das Capitais Brasileiras</p>
            <p class="footer-tech-stack">Construído com .NET 8 • C# • Blazor WebAssembly • HTML5 & CSS3 Puro • EF Core SQL Server • OpenWeatherMap</p>
        </div>
    </footer>

    <!-- Modal Acessível de Arquitetura -->
    @if (ShowInfoModal)
    {
        <div class="modal-overlay" 
             role="dialog" 
             aria-modal="true" 
             aria-labelledby="modalTitle" 
             @onclick="ToggleInfoModal">
            <div class="modal-content-card" @onclick:stopPropagation="true">
                <header class="modal-header">
                    <h2 id="modalTitle">Arquitetura & Especificação Técnica</h2>
                    <button type="button" 
                            class="btn-close-modal" 
                            @onclick="ToggleInfoModal" 
                            aria-label="Fechar janela de informações">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </button>
                </header>
                <div class="modal-body">
                    <section class="modal-section">
                        <h3>Frontend 100% Nativo</h3>
                        <p>Desenvolvido em <strong>Blazor WebAssembly (.NET 8)</strong> com <strong>HTML5 semântico</strong>, <strong>CSS3 Grid/Flexbox</strong> puro e <strong>gráficos vetoriais SVG nativos</strong> em componentes Razor, totalmente livre de bibliotecas visuais ou scripts externos pesados.</p>
                    </section>

                    <section class="modal-section">
                        <h3>Backend & Resiliência</h3>
                        <ul>
                            <li><strong>ASP.NET Core Web API:</strong> Endpoints RESTful versionados (<code>/api/v1/*</code>) com DTOs otimizados e FluentValidation.</li>
                            <li><strong>Background Service:</strong> Coleta periódica a cada 15 minutos de todas as 27 capitais via <code>PeriodicTimer</code>.</li>
                            <li><strong>Polly:</strong> Políticas de retry exponencial e contingência com diagnósticos transparentes.</li>
                            <li><strong>Entity Framework Core 8:</strong> Persistência relacional em SQL Server com índices compostos de alta performance.</li>
                        </ul>
                    </section>
                </div>
                <footer class="modal-footer">
                    <button type="button" class="btn-modal-close" @onclick="ToggleInfoModal">Fechar</button>
                </footer>
            </div>
        </div>
    }
</div>

@code {
    private bool ShowInfoModal = false;

    private void ToggleInfoModal()
    {
        ShowInfoModal = !ShowInfoModal;
    }
}
