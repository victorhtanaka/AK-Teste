<article class="stat-card" aria-label="@Title: @Value @Unit">
    <header class="stat-card-header">
        <span class="stat-card-title">@Title</span>
        <div class="stat-card-icon @ColorClass" aria-hidden="true">
            @if (IconContent != null)
            {
                @IconContent
            }
            else
            {
                @switch (IconType)
                {
                    case "temp-max":
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z" />
                            <path d="M12 9v5" />
                            <path d="M18 5l3 3m0-3l-3 3" />
                        </svg>
                        break;
                    case "temp-min":
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z" />
                            <path d="M12 12v2" />
                            <path d="M18 11l3 3m0-3l-3 3" />
                        </svg>
                        break;
                    case "temp-avg":
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z" />
                            <circle cx="11.5" cy="18.5" r="2.5" fill="currentColor" />
                        </svg>
                        break;
                    case "feels":
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                            <path d="M17 11l2 2 4-4" />
                        </svg>
                        break;
                    case "humidity":
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
                        </svg>
                        break;
                    case "wind":
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2" />
                        </svg>
                        break;
                    case "pressure":
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 6v6l4 2" />
                            <path d="M16 12h2" />
                            <path d="M6 12h2" />
                        </svg>
                        break;
                    case "records":
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 6h16M4 12h16M4 18h16" />
                            <circle cx="8" cy="6" r="1.5" fill="currentColor" />
                            <circle cx="8" cy="12" r="1.5" fill="currentColor" />
                            <circle cx="8" cy="18" r="1.5" fill="currentColor" />
                        </svg>
                        break;
                    default:
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 16v-4M12 8h.01" />
                        </svg>
                        break;
                }
            }
        </div>
    </header>

    <div class="stat-card-body">
        @if (IsLoading)
        {
            <div class="skeleton-shimmer skeleton-value"></div>
        }
        else
        {
            <span class="stat-card-value">@Value</span>
            @if (!string.IsNullOrEmpty(Unit))
            {
                <span class="stat-card-unit">@Unit</span>
            }
        }
    </div>

    <footer class="stat-card-footer">
        <span>@Subtitle</span>
    </footer>
</article>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = "-";

    [Parameter]
    public string Unit { get; set; } = string.Empty;

    [Parameter]
    public string IconType { get; set; } = "temp";

    [Parameter]
    public RenderFragment? IconContent { get; set; }

    [Parameter]
    public string ColorClass { get; set; } = "blue";

    [Parameter]
    public string Subtitle { get; set; } = string.Empty;

    [Parameter]
    public bool IsLoading { get; set; } = false;
}
